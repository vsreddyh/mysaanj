// Copy to backend/.env and fill in real values. backend/.env is gitignored.
MONGO_URL=<mongodb-uri-used-by-mongoose>
MONGO=<mongodb-uri-used-by-gridfs>
API_KEY_1=<google-gemini-key>
API_KEY_2=<google-gemini-key>
SESSION_KEY=<random-session-secret>
# Local prototype only. Leave unset in production so the demo login endpoints
# return 503 instead of creating fixed caretaker/doctor sessions.
DEMO_LOGIN=1
# PORT=3000
# NODE_ENV=development
